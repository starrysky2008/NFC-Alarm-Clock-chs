	<string name="description_dismiss_options_volume_dismiss_alarm">Dismiss the alarm by pressing the volume up or down button.</string>
	<string name="description_dismiss_options_volume_dismiss_timer">Dismiss the timer by pressing the volume up or down button.</string>
	<string name="description_snooze_options_auto_snooze">Snooze the alarm automatically after a set duration.</string>
