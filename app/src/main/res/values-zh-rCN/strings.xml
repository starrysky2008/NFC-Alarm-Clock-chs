	<!-- Descriptions -->
	<string name="description_onboarding_welcome">Welcome to the most customizable alarm clock app you have ever used</string>
	<string name="description_onboarding_permissions">The app needs some permissions to work properly</string>
	<string name="description_onboarding_permission_post_notifications_request">Required for alarms to run. Allows the app to start and stay running when not already in focus.</string>
	<string name="description_onboarding_permission_system_alert_window_request">This is a special permission. Used to ensure that the alarm screen is shown and audio can be played. Only required on Android 15, or if there is device-specific issue where alarms are not running.</string>
	<string name="description_onboarding_how_to_use_features">Some stuff can be hidden or confusing. Here is how to do those things</string>
	<string name="description_onboarding_how_to_copy_and_delete">Swipe an alarm or timer right to copy and left to delete.</string>
	<string name="description_onboarding_how_to_get_more_options">Long press on almost any button in an expanded alarm/timer to access more options.  You can even try it on an alarm card to get options like "Skip next alarm" and more.</string>
	<string name="description_onboarding_how_to_change_appearance">Go to Settings > Appearance to find all the customization options, and get the app looking the way you want it to look.</string>
