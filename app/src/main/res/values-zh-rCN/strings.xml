	<string name="description_alarm_screen_show_music_info_false">Do not show music or ringtone information.</string>
	<string name="description_alarm_screen_battery_saver_true">Save battery by keeping the screen off when an alarm is active. The screen will need to be turned on manually.</string>
	<string name="description_alarm_screen_battery_saver_false">Screen will turn on automatically when an alarm is active.</string>
	<string name="description_toggle_alarms_with_airplane_mode_true">Turning airplane mode on will disable all alarms, and turning airplane mode off will enable all alarms.  Note: The app must be in focus for this to work.</string>
	<string name="description_toggle_alarms_with_airplane_mode_false">Alarms will be unaffected when airplane mode is turned on or off.</string>
