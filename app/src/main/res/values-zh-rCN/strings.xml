	<string name="description_scan_nfc_tag_alarm">The scanned NFC tag will be required to dismiss this alarm when it goes off.</string>
	<string name="description_scan_nfc_tag_timer">The scanned NFC tag will be required to dismiss this timer when it goes off.</string>
	<string name="description_select_nfc_tag_alarm">Select an NFC tag that will be required to dismiss this alarm when it goes off. If more than one is selected, it can also be used to dismiss this alarm.</string>
	<string name="description_select_nfc_tag_timer">Select an NFC tag that will be required to dismiss this timer when it goes off. If more than one is selected, it can also be used to dismiss this timer.</string>
	<string name="description_nfc_tag_dismiss_order">Order in which the NFC tags above should be dismissed. Enabling this means all selected NFC tags will need to be scanned in order to dismiss.</string>
	<string name="description_start_timer_on_single_nfc_tag_scan">When the app is running and the NFC tag is scanned (not in this screen), it will automatically start this timer.</string>
	<string name="description_start_timer_on_multiple_nfc_tag_scan">When the app is running and one of the selected NFC tags are scanned (not in this screen), it will automatically start this timer.</string>
	<string name="description_add_or_replace_nfc_tag">Should the NFC tag be added to the list of NFC tags that can dismiss this alarm, or should it replace any NFC tags that are being used by this alarm?</string>
	<string name="description_save_nfc_tag">You can reuse this NFC tag, without having to scan it again, by giving it a name.</string>
	<string name="description_repeat_frequency">Repeat the alarm at a given frequency (every X amount of time).  Note: Selecting hours or days will clear all of the alarm\'s days.</string>
	<string name="description_repeat_frequency_days_to_run_before_starting">Which of the alarm\'s currently selected days should be run this week before starting the frequency.</string>
	<string name="description_vibrate_vibration_duration">How long to vibrate for, and how long to wait in between vibrations.</string>
	<string name="description_vibrate_custom_pattern">Repeat the vibration duration a set number of times, and then wait for a duration.</string>
	<string name="description_flashlight_brightness_level">Brightness level of the flashlight.</string>
	<string name="description_flashlight_blink_on_off">Blink the flashlight on and off at set durations.</string>
	<string name="description_text_to_speech_what_to_say_alarm">What to say with text-to-speech when the alarm is active.</string>
	<string name="description_text_to_speech_what_to_say_timer">What to say with text-to-speech when the timer is active.</string>
	<string name="description_text_to_speech_speak_frequency">How often to say the selected items above.</string>
	<string name="description_text_to_speech_speech_rate">How fast text-to-speech should speak.</string>
	<string name="description_volume_gradually_increase_volume_alarm">Increase the volume of the alarm at a set frequency.</string>
	<string name="description_volume_gradually_increase_volume_timer">Increase the volume of the timer at a set frequency.</string>
	<string name="description_volume_restrict_volume_alarm">Volume cannot be decreased when the alarm goes off.</string>
	<string name="description_volume_restrict_volume_timer">Volume cannot be decreased when the timer goes off.</string>
	<string name="description_dismiss_options_auto_dismiss_alarm">Dismiss the alarm automatically after a set duration.</string>
